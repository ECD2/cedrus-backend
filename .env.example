# ── Server ──────────────────────────────────────────────
PORT=3000
# Environment. Set to `production` on Railway. In production the app refuses to
# boot if the Twilio signature bypass is on or PUBLIC_BASE_URL is unset.
NODE_ENV=development
# REQUIRED when VALIDATE_TWILIO_SIGNATURE is on: the public URL the signed
# webhook URL is built from. The signed URL is NEVER derived from the Host
# header (spoofable). Also used for the Twilio delivery-status callback.
PUBLIC_BASE_URL=https://your-app.up.railway.app
DEFAULT_TIMEZONE=America/New_York
ENABLE_JOBS=true
# Local-dev escape hatch ONLY. Forbidden in production (fail-closed at boot).
VALIDATE_TWILIO_SIGNATURE=true

# ── Supabase (SERVICE ROLE key — server-side only, bypasses RLS) ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── OpenAI ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# ── Twilio ──────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# Founder admin (header-authed POST routes: /admin/user, /admin/reset-user).
# Sent as the `x-admin-key` HEADER, never in a URL/query string. Constant-time
# compared. Leave unset to disable all admin routes (they return 404).
ADMIN_KEY=pick-a-long-random-string

# Allow-list for POST /admin/reset-user (the safe per-user tester reset).
# Comma-separated phone numbers; any format. reset-user refuses any number NOT
# in this list. Leave empty to disable the reset tool entirely.
TESTER_PHONES=17869727469,15551234567

# ── Chief of Staff daily brief (jobs/cosDailyBrief.js) ──────────────────
# DISARMED BY DEFAULT. Every variable below is off unless set, and the job
# announces which mode it ran in on every single tick.
#
# These point at the CHIEF OF STAFF Supabase project, which is a DIFFERENT
# project from SUPABASE_URL above. Do not reuse those values here.
#
# THE LADDER IS ORDERED. Each rung is safe to sit on indefinitely, and each one
# proves something the next rung depends on. Do not skip a rung.

# Rung 1 — arm the reader. Both required; exactly one set is a boot failure in
# production. Reads only: nothing is composed, sent, or written.
COS_SUPABASE_URL=https://kpzyzjhfvjfvxowhusir.supabase.co
COS_SERVICE_ROLE_KEY=the-chief-of-staff-service-role-key

# Rung 2 — wire the spend accounting BEFORE anything makes a model call.
# This repo's app_users id (NOT the CoS uuid below — different database).
# Rung 3 makes a real billable OpenAI call, and until this is set that spend is
# not written to agent_runs and does NOT count toward DAILY_TOKEN_BUDGET, which
# is the only spend ceiling this job has. Setting it first costs nothing.
# The job warns on every run while it is unset.
COS_BRIEF_USAGE_USER_ID=

# Rung 3 — rehearse. Composes and logs the brief. Real billable model call.
# No email, no writeback, no ledger claim.
COS_BRIEF_DRY_RUN=true

# Rung 4 — prove the writeback. Composes AND inserts the row into CoS's
# today_briefs, so the brief appears in the Chief of Staff app. Still no email.
# Overrides COS_BRIEF_LIVE, so it stays safe even if that is set early.
#
# This rung exists because the live path sends FIRST and writes SECOND. If the
# writeback is going to fail — a drifted column, an unresolvable owner id — it
# must fail here, where no email has gone out, rather than on the live path
# where the mail has already left and the ledger already says 'sent'.
# Each run inserts one row; repeated runs leave repeated rows (delete to undo).
# Unset COS_BRIEF_DRY_RUN before using this rung.
COS_BRIEF_WRITEBACK_ONLY=false

# Rung 5 — deliver. ALL THREE required for a single email to leave.
# There is deliberately no default recipient.
# Unset COS_BRIEF_DRY_RUN and COS_BRIEF_WRITEBACK_ONLY first.
COS_BRIEF_LIVE=false
RESEND_API_KEY=re_...
COS_BRIEF_TO=you@example.com

# Optional. From address must stay on the Resend-VERIFIED subdomain; the root
# domain is Purelymail's with DMARC p=reject and would fail alignment.
COS_BRIEF_FROM=Cedrus <brief@updates.cedrus.life>
COS_BRIEF_REPLY_TO=emil@cedrus.life

# Optional. The CoS owner's auth.users uuid, used for the today_briefs
# writeback. If unset it is derived from the newest existing today_briefs row.
COS_USER_ID=

# Optional. Defaults to OPENAI_MODEL. The value is written into CoS's
# today_briefs.model column, so it must name the model that actually ran.
COS_BRIEF_MODEL=
