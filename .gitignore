node_modules/
.env
.env.local
npm-debug.log*
.DS_Store
bun.lock
bun.lockb

# Supabase CLI local state. .temp holds a pooler URL with credentials —
# never commit it. migrations/ and config.toml ARE tracked on purpose.
supabase/.temp/
supabase/.branches/

# Python bytecode, anywhere. The apply/backfill scripts under scripts/ are the
# only Python here so far, but the pattern is deliberately not scoped to them:
# a .pyc carries NUL bytes, and test/no-nul-bytes.sh fails the battery on any
# tracked file that does.
__pycache__/

# node_modules as a SYMLINK (worktrees link to the main checkout). The bare
# "node_modules/" pattern above matches a DIRECTORY only, so a symlink of that
# name was committable — and committing one replaced the real directory with a
# self-referential link, breaking module resolution repo-wide (2026-08-20).
node_modules
